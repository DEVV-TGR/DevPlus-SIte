# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# exceção: o .env.example não tem segredos nenhuns — é a lista do que é preciso
# configurar. Sem esta linha o padrão acima apanhava-o.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# originais dos prints (ficam só no disco — o que vai para o site são as
# versões otimizadas em public/portfolio/). Ver docs/06-projetos.md.
/images/*
# exceção: os originais da identidade são versionados — são os inputs de
# scripts/vectorizar-logo.py e scripts/mkico.py. Ver docs/03-simbolo-e-logotipo.md.
!/images/Dev+-logosimples.png
!/images/Dev+-icone-2000.png

# agentes — .claude/settings.json e .claude/skills/ são versionados (a
# configuração e as skills são partilhadas). O que é da máquina de cada um
# fica de fora.
/.claude/settings.local.json
/.claude/worktrees/
